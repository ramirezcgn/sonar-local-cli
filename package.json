{
  "name": "sonar-local-cli",
  "version": "0.1.7",
  "description": "Run real SonarQube/SonarCloud Connected-Mode analysis locally, no Java pre-install, no Docker, no MCP server — auto-downloads a portable JRE and the sonarlint-cli engine on first run.",
  "type": "module",
  "bin": {
    "sonar-local": "bin/sonar-local.js"
  },
  "files": [
    "bin",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=21.7.0"
  },
  "license": "MIT",
  "keywords": [
    "sonarqube",
    "sonarcloud",
    "sonarlint",
    "static-analysis",
    "code-quality",
    "lint"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ramirezcgn/sonar-local-cli.git"
  },
  "author": "",
  "scripts": {
    "test": "node --test test/",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.10"
  }
}
